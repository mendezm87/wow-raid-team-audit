# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Google Apps Script Web App Deployment URL (e.g. https://script.google.com/macros/s/AKfycb.../exec)
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# (Optional, recommended) Shared secret so only this bot can write sims to the sheet.
# Must match the WEBHOOK_SECRET Script Property in Apps Script (Project Settings > Script Properties).
WEBHOOK_SECRET=

# (Optional) Restrict auto-listening to a specific Discord channel ID (e.g. #raid-sims)
# Leave blank to listen in any channel where the bot has permission
SIMS_CHANNEL_ID=
